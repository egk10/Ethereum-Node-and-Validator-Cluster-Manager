[Unit]
Description=Guarded weekly Ethereum cluster maintenance
Wants=network-online.target
After=network-online.target docker.service integra-botinterno.service

[Service]
Type=oneshot
User=egk
WorkingDirectory=/opt/egkcluster
EnvironmentFile=/opt/egkcluster/maintenance.env
ExecStart=/usr/bin/python3 /opt/egkcluster/cluster-maintenance.py --config /opt/egkcluster/maintenance.json --run
TimeoutStartSec=18h
